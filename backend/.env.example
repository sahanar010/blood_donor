DATABASE_URL=postgresql+psycopg://bloodmatch:bloodmatch@localhost:5432/bloodmatch
SECRET_KEY=generate-a-long-random-string
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=admin12345
LOCAL_TZ=Asia/Kolkata
# Policy value - set per your blood bank / hospital rules, not decided by this app
MIN_DONATION_INTERVAL_DAYS=90
W_DISTANCE=0.30
W_AVAILABILITY=0.20
W_RELIABILITY=0.20
W_TRAVEL=0.10
W_ML=0.10
W_RATING=0.10

# Optional: enables cross-worker realtime + presence (in-memory if unset/unreachable)
# REDIS_URL=redis://localhost:6379/0
ENABLE_DEMO_PAGE=true

# ML acceptance model (rules-only ranking if the model file is missing)
ML_ENABLED=true
